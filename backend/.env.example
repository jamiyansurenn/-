DATABASE_URL=postgresql://user:pass@host:5432/db

# Comma-separated origins (Vercel production + preview)
CORS_ORIGIN=https://daatsiintsamhag.mn,https://www.daatsiintsamhag.mn

# local = files on disk (LOST on Render redeploy). Use s3 in production.
STORAGE_DRIVER=s3
S3_REGION=ap-southeast-1
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com

# If STORAGE_DRIVER=local (dev only)
# UPLOAD_DEST=./uploads
